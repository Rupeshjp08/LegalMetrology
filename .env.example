# Backend gateway URL for the Packaged Commodity Legal Metrology
# Compliance System. Point this at the backend API server.
#
# Fallback: '/api' (relative mount) when unset.
VITE_API_BASE_URL=http://localhost:5000/api

# Google Gemini API key for Legal Metrology AI-based product information extraction (STEP 8).
# Acquire from Google AI Studio (https://aistudio.google.com/app/apikey).
# NOTE: Gemini API keys are strings starting with "AIza...".
#       Keys that do NOT match this format (e.g. stray OAuth tokens) will be
#       rejected by Gemini and cause "AI extraction failed" errors.
# Keep secret and do not commit real keys to source control (.env is git-ignored).
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: backend-held Gemini key for server-side extraction.
# When a real backend is deployed, use this instead of the VITE_ key so the
# key is never bundled into the frontend.
GEMINI_API_KEY=your_gemini_api_key_here